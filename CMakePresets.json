{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "KSS_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-private",
      "inherits": "windows-msvc",
      "displayName": "Windows MSVC x64 with private generated blocks",
      "binaryDir": "${sourceDir}/build/windows-private",
      "cacheVariables": {
        "KSS_USE_PRIVATE_GENERATED": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "KSS_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "windows-msvc-private-debug",
      "configurePreset": "windows-msvc-private"
    },
    {
      "name": "linux-ninja-debug",
      "configurePreset": "linux-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-msvc-private-debug",
      "configurePreset": "windows-msvc-private",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-ninja-debug",
      "configurePreset": "linux-ninja",
      "output": { "outputOnFailure": true }
    }
  ]
}
