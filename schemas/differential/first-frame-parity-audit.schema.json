{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "data_boundary",
    "hardware_reference",
    "native_runtime_observation",
    "claims",
    "residual_divergences",
    "sources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "verdict": {
      "type": "object",
      "required": ["full_first_frame_parity_proven", "reason"],
      "properties": {
        "full_first_frame_parity_proven": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "data_boundary": {
      "type": "object",
      "required": ["policy", "rom_bytes_included", "spc_ipl_bytes_included", "pixel_payload_included", "private_trace_records_included"],
      "properties": {
        "policy": {"const": "sanitized-digests-counts-and-identities-only"},
        "rom_bytes_included": {"const": false},
        "spc_ipl_bytes_included": {"const": false},
        "pixel_payload_included": {"const": false},
        "private_trace_records_included": {"const": false}
      }
    },
    "hardware_reference": {"type": "object"},
    "native_runtime_observation": {"type": "object"},
    "claims": {
      "type": "object",
      "required": ["proven_now", "not_proven"],
      "properties": {
        "proven_now": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "not_proven": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "residual_divergences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["area", "reference", "runtime", "required_proof"],
        "properties": {
          "area": {"type": "string"},
          "reference": {"type": "string"},
          "runtime": {"type": "string"},
          "required_proof": {"type": "string"}
        }
      }
    },
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
