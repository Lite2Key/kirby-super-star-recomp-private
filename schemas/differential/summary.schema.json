{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kss-recomp.invalid/schemas/differential/summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passed", "reference_sha256", "candidate_sha256", "state_records", "write_records", "processors", "mismatch_count", "mismatches"],
  "properties": {
    "schema_version": { "const": 1 },
    "passed": { "type": "boolean" },
    "reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state_records": { "type": "integer", "minimum": 0 },
    "write_records": { "type": "integer", "minimum": 0 },
    "processors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scpu", "sa1"],
      "properties": {
        "scpu": { "type": "integer", "minimum": 0 },
        "sa1": { "type": "integer", "minimum": 0 }
      }
    },
    "mismatch_count": { "type": "integer", "minimum": 0 },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "index", "fields"],
        "properties": {
          "record": { "enum": ["state", "write"] },
          "index": { "type": "integer", "minimum": 0 },
          "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
