{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "boundary", "master_clock", "probe_status", "capture_fidelity", "data_boundary", "full_first_frame_parity_proven", "chains", "spc_directions", "hard_gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "boundary": {"const": "live_scpu_spc_then_scheduled_first_frame"},
    "master_clock": {"const": 306900},
    "probe_status": {"const": "expected_frontier_reached"},
    "capture_fidelity": {"const": "cooperative-reset-whole-instruction-cpu-and-architectural-spc-cycles"},
    "data_boundary": {"const": "sanitized-digests-and-counts-only"},
    "full_first_frame_parity_proven": {"const": false},
    "chains": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": {"$ref": "#/$defs/chain"}},
    "spc_directions": {"type": "object", "required": ["cpu_to_spc", "spc_to_cpu"], "additionalProperties": {"$ref": "#/$defs/counts"}},
    "hard_gaps": {"type": "array", "minItems": 3, "items": {"type": "string"}}
  },
  "$defs": {
    "counts": {"type": "object", "additionalProperties": false, "required": ["runtime_records", "reference_records", "delta"], "properties": {"runtime_records": {"type": "integer", "minimum": 0}, "reference_records": {"type": "integer", "minimum": 0}, "delta": {"type": "integer"}}},
    "chain": {"type": "object", "additionalProperties": false, "required": ["runtime_records", "reference_records", "delta", "runtime_sha256", "matches"], "properties": {"runtime_records": {"type": "integer", "minimum": 0}, "reference_records": {"type": "integer", "minimum": 0}, "delta": {"type": "integer"}, "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "matches": {"type": "boolean"}}}
  }
}
