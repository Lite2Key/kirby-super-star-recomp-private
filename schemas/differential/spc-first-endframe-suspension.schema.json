      "properties": {
        "exact_master_observation_represented": {"const": true},
        "real_core_mutated_by_preview": {"const": false},
        "coordinator_advanced_by_preview": {"const": false},
        "speculative_port_events_emitted": {"const": false},
        "partial_architectural_state_fabricated": {"const": false},
        "state_patched": {"const": false},
        "state_rewound": {"const": false},
        "private_rom_runtime_capture_claimed": {"const": false}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
