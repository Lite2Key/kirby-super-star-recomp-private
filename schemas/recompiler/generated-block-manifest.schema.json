{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kss-recomp.invalid/schemas/recompiler/generated-block-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "input_sha256", "max_blocks_per_processor", "registered_blocks", "processors", "identity_policy", "failure_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {"const": "kssrecomp.generated_blocks-v1"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_blocks_per_processor": {"type": "integer", "minimum": 1, "maximum": 4096},
    "registered_blocks": {"type": "integer", "minimum": 0, "maximum": 8192},
    "processors": {
      "type": "object", "additionalProperties": false, "required": ["scpu", "sa1"],
      "properties": {"scpu": {"type": "integer", "minimum": 0}, "sa1": {"type": "integer", "minimum": 0}}
    },
    "identity_policy": {"const": "processor-pc24-emulation-m8-x8"},
    "failure_policy": {"const": "stop-on-lift-failure-omit-unresolved"}
  }
}
