{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/kss-recomp/progress.schema.json",
  "title": "Kirby Super Star recompilation progress evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot", "milestones", "components", "scenarios", "blockers", "next_proof", "trends"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "commit", "dirty", "rom_id", "toolchain_manifest_hash", "evidence"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "commit": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "rom_id": { "type": "string", "minLength": 1 },
        "toolchain_manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tests", "builds"],
          "properties": {
            "tests": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
            "builds": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
          }
        }
      }
    },
    "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } },
    "next_proof": { "$ref": "#/$defs/nextProof" },
    "trends": { "type": "array", "items": { "$ref": "#/$defs/trendPoint" } }
  },
  "$defs": {
    "status": { "enum": ["not_started", "in_progress", "blocked", "passed", "failed"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "total", "denominator"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "denominator": { "enum": ["fixed", "evolving"] },
        "note": { "type": "string" }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "summary", "gate"],
      "properties": {
        "id": { "type": "string", "pattern": "^M[0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "status", "metrics", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "group": { "enum": ["analysis", "recompiler", "runtime", "validation", "delivery"] },
        "status": { "$ref": "#/$defs/status" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "status", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "required": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "nextProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "acceptance", "owner"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "trendPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "verified_blocks", "passing_scenarios", "open_divergences", "build_seconds"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "verified_blocks": { "type": "integer", "minimum": 0 },
        "passing_scenarios": { "type": "integer", "minimum": 0 },
        "open_divergences": { "type": "integer", "minimum": 0 },
        "build_seconds": { "type": ["number", "null"], "minimum": 0 },
        "observed_scpu_blocks": { "type": "integer", "minimum": 0 },
        "observed_sa1_blocks": { "type": "integer", "minimum": 0 },
        "trace_events": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
